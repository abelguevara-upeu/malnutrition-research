{
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/CVS": true,
    "**/.ruby-lsp": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/*.pyo": true,
    "**/.pytest_cache": true,
    "**/.ipynb_checkpoints": true,
    "**/.ruff_cache": true,
    "**/*.synctex.gz": true,
    "**/.tmp": true,
    "[!n]*/**": true,
    "n[!o]*/**": true,
    "no[!t]*/**": true,
    "not[!e]*/**": true,
    "note[!b]*/**": true,
    "noteb[!o]*/**": true,
    "notebo[!o]*/**": true,
    "noteboo[!k]*/**": true,
    "notebook[!s]*/**": true,
    "notebooks/[!0]*/**": true,
    "notebooks/0[!1]*/**": true,
    "notebooks/01[!_]*/**": true,
    "notebooks/01_[!d]*/**": true,
    "notebooks/01_d[!a]*/**": true,
    "notebooks/01_da[!t]*/**": true,
    "notebooks/01_dat[!a]*/**": true,
    "notebooks/01_data[!_]*/**": true,
    "notebooks/01_data_[!u]*/**": true,
    "notebooks/01_data_u[!n]*/**": true,
    "notebooks/01_data_un[!d]*/**": true,
    "notebooks/01_data_und[!e]*/**": true,
    "notebooks/01_data_unde[!r]*/**": true,
    "notebooks/01_data_under[!s]*/**": true,
    "notebooks/01_data_unders[!t]*/**": true,
    "notebooks/01_data_underst[!a]*/**": true,
    "notebooks/01_data_understa[!n]*/**": true,
    "notebooks/01_data_understan[!d]*/**": true,
    "notebooks/01_data_understand[!i]*/**": true,
    "notebooks/01_data_understandi[!n]*/**": true,
    "notebooks/01_data_understandin[!g]*/**": true,
    "notebooks/01_data_understanding/[!r]*/**": true,
    "notebooks/01_data_understanding/r[!e]*/**": true,
    "notebooks/01_data_understanding/re[!c]*/**": true,
    "notebooks/01_data_understanding/rec[!h]*/**": true,
    "notebooks/01_data_understanding/rech[!2]*/**": true,
    "notebooks/01_data_understanding/rech2[!3]*/**": true,
    "notebooks/01_data_understanding/rech23[!_]*/**": true,
    "notebooks/01_data_understanding/rech23_[!g]*/**": true,
    "notebooks/01_data_understanding/rech23_g[!e]*/**": true,
    "notebooks/01_data_understanding/rech23_ge[!o]*/**": true,
    "notebooks/01_data_understanding/rech23_geo[!g]*/**": true,
    "notebooks/01_data_understanding/rech23_geog[!r]*/**": true,
    "notebooks/01_data_understanding/rech23_geogr[!a]*/**": true,
    "notebooks/01_data_understanding/rech23_geogra[!f]*/**": true,
    "notebooks/01_data_understanding/rech23_geograf[!i]*/**": true,
    "notebooks/01_data_understanding/rech23_geografi[!a]*/**": true
  },
  "search.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.tmp": true
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "pyproject.toml": ".python-version, .pypirc, poetry.lock, uv.lock, pip-*, requirements*, .gitignore, .gitattributes, .gitkeep",
    "Makefile": "Dockerfile, latex.Dockerfile, docker-compose.yml, .dockerignore, docker-compose.override.yml, .devcontainer.json, .env, .env.example, .env.*, .latexmkrc",
    "README.md": "LICENSE, LICENSE.md, CHANGELOG.md, CONTRIBUTING.md, *.mmd"
  },
  "latex-workshop.docker.enabled": true,
  "latex-workshop.docker.image.latex": "latex-compiler:latest",
  // --- PREVENIR LAG EN EL EDITOR (USANDO DOCKER) ---
  // Desactivamos kpsewhich local en el host, ya que LaTeX no está instalado 
  // en tu Mac y causa timeouts/retrasos molestos al buscar paquetes.
  "latex-workshop.kpsewhich.enabled": false,
  "latex-workshop.kpsewhich.class.enabled": false,
  "latex-workshop.kpsewhich.bibtex.enabled": false,
  // --- HIGIENE PROFESIONAL DEL PROYECTO ---
  // No necesitamos borrar a la fuerza los archivos temporales porque
  // nativamente los enviamos a la carpeta oculta tmp/ en nuestro latexmkrc.
  "latex-workshop.latex.clean.enabled": false,
  "latex-workshop.latex.auxDir": "%DIR%/.tmp",
  "notebook.formatOnSave.enabled": true,
  "notebook.globalToolbar": true,
  "notebook.output.scrolling": true,
  "notebook.output.textLineLimit": 40,
  "notebook.stickyScroll.enabled": true,
  "notebook.markdown.lineHeight": 0,
}